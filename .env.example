# =============================================================================
# SGHL — Variables d'environnement (local / Render)
# Copiez ce fichier en .env pour le développement local si vous utilisez python-dotenv.
# Sur Render : renseignez ces variables dans le dashboard du service.
# =============================================================================

# --- Django core ---
SECRET_KEY=change-me-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Afficher le code OTP dans la console runserver (DEV uniquement)
SHOW_MFA_CODE_IN_CONSOLE=True

# --- Base de données ---
# Option A : SQLite (défaut local, ne rien définir)
# Option B : MySQL local
# DB_ENGINE=mysql
# DB_NAME=sghl
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Option C : PostgreSQL (Render)
# DATABASE_URL=postgresql://user:password@host:5432/sghl

# --- CORS (frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Email (prod Render) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=sghl-notification@hopital.com

# --- Static files Render ---
USE_WHITENOISE=True

# --- Déploiement Render (Blueprint) ---
# Utilisez render.yaml à la racine du projet :
# Render Dashboard → New → Blueprint → connecter le dépôt Git
# Les variables ci-dessous sont injectées automatiquement par le Blueprint.

# --- Frontend Vue (sghl_frontend/.env) ---
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v2
